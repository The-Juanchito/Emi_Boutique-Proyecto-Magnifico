# Copia este archivo como .env para pruebas locales. En Netlify estas variables se cargan en el panel (Site configuration > Environment variables).
# NUNCA subas el archivo .env a GitHub.

# --- Base de datos: SQL Server / Azure SQL ---
DB_SERVER=tuservidor.database.windows.net
DB_NAME=emi_boutique
DB_USER=
DB_PASSWORD=
# DB_PORT=1433

# --- Supabase Storage (opcional: solo para subir fotos desde el panel) ---
SUPABASE_URL=https://hlcaknmiouetzriwiits.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Sesiones (cadena aleatoria de 32+ caracteres) ---
SESSION_SECRET=

# --- Wompi (llaves de PRUEBA al inicio: pub_test_..., test_integrity_..., test_events_...) ---
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# --- Pagos simulados (demo). Pon 0 para apagarlos cuando cobres de verdad ---
PAGOS_SIMULADOS=1

# --- Sitio (sin / al final) ---
SITE_URL=https://TU-SITIO.netlify.app

# --- Correo (opcional; ej. Gmail con contraseña de aplicación) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM="EMI Boutique <tu-correo@gmail.com>"

# --- Opcionales ---
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
AI_API_KEY=
